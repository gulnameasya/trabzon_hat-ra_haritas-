# PostgreSQL bağlantısı
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trabzon_hatira

# Sunucu
PORT=4000

# Admin girişi (basit, tek admin - üyelik sistemi yok)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=degistir_bu_sifreyi
JWT_SECRET=cok-gizli-bir-anahtar-buraya

# Yüklenen fotoğrafların diskte tutulacağı klasör
UPLOAD_DIR=uploads

# Reddedilen fotoğraflar için SMS bildirimi (Netgsm)
# Hesap açmadan/bu bilgileri boş bırakırsanız sistem "simülasyon" modunda
# çalışır — mesaj veritabanına yazılır ama gerçekten gönderilmez.
# Hesap: https://www.netgsm.com.tr (ücretli, kontör satın almanız gerekir)
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
