# PostgreSQL bağlantısı
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trabzon_hatira

# Sunucu
PORT=4000

# Admin girişi (basit, tek admin - üyelik sistemi yok)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=degistir_bu_sifreyi
JWT_SECRET=cok-gizli-bir-anahtar-buraya

# Yüklenen fotoğrafların diskte tutulacağı klasör
UPLOAD_DIR=uploads
